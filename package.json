{
  "name": "volt",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "server:dev": "pnpm --filter @volt/server dev",
    "server:build": "pnpm --filter @volt/server build",
    "server:start": "pnpm --filter @volt/server start",
    "server:test": "pnpm --filter @volt/server test",
    "server:typecheck": "pnpm --filter @volt/server typecheck",
    "test": "ng test",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"apps/server/**/*.{ts,json}\" \"*.json\" \"*.md\" \"*.yaml\" .prettierrc",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"apps/server/**/*.{ts,json}\" \"*.json\" \"*.md\" \"*.yaml\" .prettierrc"
  },
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
