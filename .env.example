HOST=0.0.0.0
PORT=8080
DEMO_MODE=true
NUT_HOST=
NUT_NAME=
NUT_PORT=3493
NUT_TLS=false
NUT_USERNAME=
NUT_PASSWORD=
CREDENTIALS_ENCRYPTION_KEY=
CLEAR_NUT_CREDENTIALS=false
POLL_INTERVAL_SECONDS=5
DISCOVERY_INTERVAL_SECONDS=60
NUT_TIMEOUT_MS=5000
SAMPLE_INTERVAL_SECONDS=30
HISTORY_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=90
DATA_DIR=.data
WEB_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
VOLT_BIND_ADDRESS=0.0.0.0
VOLT_PORT=8080
# Comma-separated IP addresses or CIDRs for trusted reverse proxies that overwrite X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
# Optional Infisical Universal Auth. When configured, auth secrets below are loaded at startup.
INFISICAL_SITE_URL=https://us.infisical.com
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=prod
INFISICAL_SECRET_PATH=/
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_ID_FILE=
INFISICAL_CLIENT_SECRET=
INFISICAL_CLIENT_SECRET_FILE=
# Temporarily set true to log the first four characters of the Universal Auth credentials.
INFISICAL_DEBUG=false
# Optional folder overrides; empty values fall back to INFISICAL_SECRET_PATH.
INFISICAL_AUTH_SECRET_PATH=
INFISICAL_OIDC_SECRET_PATH=
# Environment and *_FILE auth settings take precedence; Infisical fills missing values.
AUTH_EMAIL=
AUTH_EMAIL_FILE=
AUTH_PASSWORD=
AUTH_PASSWORD_FILE=
AUTH_COOKIE_SECURE=
# OIDC settings can be supplied here or stored in Infisical at INFISICAL_OIDC_SECRET_PATH.
OIDC_ISSUER=
OIDC_ISSUER_FILE=
OIDC_CLIENT_ID=
OIDC_CLIENT_ID_FILE=
OIDC_CLIENT_SECRET=
OIDC_CLIENT_SECRET_FILE=
OIDC_CLIENT_AUTH_METHOD=
OIDC_CLIENT_AUTH_METHOD_FILE=
OIDC_REDIRECT_URI=
OIDC_REDIRECT_URI_FILE=
